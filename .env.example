# SkateSet - Environment Variables Example
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositorio!

# Turso Database (libSQL) - Usado diretamente pelo frontend
VITE_TURSO_URL=sua_url_turso_aqui
VITE_TURSO_AUTH_TOKEN=seu_token_turso_aqui

# Groq AI API - Usado diretamente pelo frontend
VITE_GROQ_API_KEY=sua_chave_groq_aqui

# ImgBB Image Hosting - Usado diretamente pelo frontend
VITE_IMGBB_API_KEY=sua_chave_imbb_aqui

# Mistral AI API - Usado pelo chatbot Charlie
VITE_MISTRAL_API_KEY=sua_chave_mistral_aqui

# Image Search APIs
VITE_PIXABAY_API_KEY=sua_chave_pixabay_aqui
VITE_PEXELS_API_KEY=sua_chave_pexels_aqui
